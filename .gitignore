# Zaviyar Enterprises Website - Git Ignore File

# Operating System Files
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# Editor and IDE Files
# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs (WebStorm, PhpStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# Temporary Files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~.nib
*.log

# Build and Deployment
dist/
build/
out/
.cache/
*.bundle.js
*.bundle.css

# Dependencies (if npm/yarn is ever added in the future)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnpm-debug.log*

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Testing
coverage/
.nyc_output/
*.lcov

# Local Development
.vscode-test/
.history/

# Image Cache (optional - uncomment if you cache Unsplash images locally)
# assets/images/unsplash/

# Backup Files
*.backup
*.old
*.orig

# Compressed Files (temporary)
*.zip
*.tar.gz
*.rar
*.7z

# Documentation Drafts
drafts/
*.draft.md

# Local Notes
notes.txt
TODO.txt
NOTES.md

# Server Configuration (if applicable)
.htaccess.local
.htpasswd

# SSL Certificates (never commit private keys)
*.pem
*.key
*.crt
*.csr
*.p12

# Database Files (if ever added)
*.sql
*.sqlite
*.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime Data
pids/
*.pid
*.seed
*.pid.lock

# MacOS Finder
.DS_Store

# Git Merge Files
*.orig

# End of .gitignore
